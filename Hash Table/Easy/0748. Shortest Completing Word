# =================================================== #
                PROBLEM DESCRITION
# =================================================== #


Given a string licensePlate and an array of strings words, find the shortest completing word in words.

A completing word is a word that contains all the letters in licensePlate. Ignore numbers and spaces in licensePlate, and treat letters as case insensitive. 

If a letter appears more than once in licensePlate, then it must appear in the word the same number of times or more.

For example, if licensePlate = "aBc 12c", then it contains letters 'a', 'b' (ignoring case), and 'c' twice. Possible completing words are "abccdef", "caaacab", and "cbca".

Return the shortest completing word in words. It is guaranteed an answer exists. If there are multiple shortest completing words, return the first one that occurs in words.


# =================================================== #
                      SOLUTION
# =================================================== #


class Solution:
    def shortestCompletingWord(self, licensePlate: str, words: List[str]) -> str:
        
        string = ''.join(char for char in licensePlate.lower() if char.isalpha())
        hash_map = {}

        shortest = None

        for char in string:
            hash_map[char] = hash_map.get(char, 0) + 1

        for word in words:
            hash_word = {}
            for char in word:
                hash_word[char] = hash_word.get(char, 0) + 1
            if all(hash_word.get(plate_char, 0) >= hash_map[plate_char] for plate_char in hash_map):
                if shortest is None or len(word) < len(shortest):
                    shortest = word

        return shortest
