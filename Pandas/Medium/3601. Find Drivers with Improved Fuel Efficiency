                      SOLUTION
# =================================================== #


import pandas as pd

def find_improved_efficiency_drivers(drivers: pd.DataFrame, trips: pd.DataFrame) -> pd.DataFrame:
    
    trips['fuel_efficiency'] = trips['distance_km'] / trips['fuel_consumed']
    trips['trip_date'] = pd.to_datetime(trips['trip_date']).dt.month
    trips['half'] = np.where(trips['trip_date'] <= 6, 'first', 'second')

    total_data = (
        trips
        .groupby(by = ['driver_id', 'half'])['fuel_efficiency']
        .mean()
        .unstack(level = - 1)
        .reset_index()
        .dropna()
        .rename(columns = {'first' : 'first_half_avg', 'second' : 'second_half_avg'})
    )

    total_data['efficiency_improvement'] = total_data['second_half_avg'] - total_data['first_half_avg']

    result = (
        pd.merge(
            left = drivers,
            right = total_data.loc[total_data['efficiency_improvement'] > 0],
            how = 'right',
            on = 'driver_id'
        )
        .round(decimals = 2)
    )
    
    return result.sort_values(by = ['efficiency_improvement', 'driver_name'], ascending = [False, True])
