# =================================================== #
                PROBLEM DESCRITION
# =================================================== #


Given a string s, return the longest palindromic substring in s.


# =================================================== #
                      SOLUTION
# =================================================== #


class Solution:
    def longestPalindrome(self, s: str) -> str:
    
        str_len = len(s)
        left_index, max_sub_str_len = 0, 1

        for j in range(str_len):
            left, right = j, j
            while left >= 0 and right < str_len and s[left] == s[right]:
                if right + 1 - left > max_sub_str_len:
                    left_index, max_sub_str_len = left, right + 1 - left
                left -= 1
                right += 1

            left, right = j, j + 1
            while left >= 0 and right < str_len and s[left] == s[right]:
                if right + 1 - left > max_sub_str_len:
                    left_index, max_sub_str_len = left, right + 1 - left
                left -= 1 
                right += 1
                
        return s[left_index : left_index + max_sub_str_len]
